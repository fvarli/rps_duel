<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         This overlay applies to the profile build only. The release manifest
         declares no permissions at all.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Profile builds carry the same .dev applicationIdSuffix as debug (see
         build.gradle.kts), so they install alongside the Google Play app.
         Without this override the profile variant would inherit "RPS Duel"
         from the main manifest and present two identically-named launcher
         entries — the Play build and a development build. Mirrors the debug
         overlay so every development variant reads "RPS Duel Dev". -->
    <application
        android:label="RPS Duel Dev"
        tools:replace="android:label" />
</manifest>
