<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         This overlay applies to the debug build only. The release manifest
         declares no permissions at all.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds install alongside the Google Play production app (see
         the .dev applicationIdSuffix in build.gradle.kts). Relabel so the two
         launcher entries cannot be confused on a physical device:
         "RPS Duel" is the Play build, "RPS Duel Dev" is this one. -->
    <application
        android:label="RPS Duel Dev"
        tools:replace="android:label" />
</manifest>
